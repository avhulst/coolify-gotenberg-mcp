# Only needed for docker-compose.local.yml. In Coolify these are set in the UI
# (MCP_AUTH_TOKEN / PUBLIC_BASE_URL are generated there automatically).

# Bearer token for /mcp (generate: openssl rand -hex 32). Empty = no auth (local only!)
MCP_AUTH_TOKEN=
# Base URL used for download links
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated allowed Host headers ("*" disables the check)
ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# Optional separate key for signing download links (default: MCP_AUTH_TOKEN)
FILE_SIGNING_KEY=

# Gotenberg (bundled service by default)
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
GOTENBERG_TIMEOUT=120

FILE_TTL_HOURS=24
MAX_INPUT_MB=50
# true = allow input_url/url_to_pdf to private/internal addresses (SSRF risk!)
ALLOW_PRIVATE_URLS=false
MCP_LOG_LEVEL=INFO
# Gotenberg log level (lowercase: error|warn|info|debug)
GOTENBERG_LOG_LEVEL=info
# Absolute host path of ./data, adds "local_path" to results
HOST_DATA_DIR=

# OAuth 2.1 (Claude/Mistral custom connectors). Password for the consent page,
# default = MCP_AUTH_TOKEN. Requires PUBLIC_BASE_URL with https (or localhost).
OAUTH_ENABLED=true
OAUTH_PASSWORD=
OAUTH_ACCESS_TOKEN_TTL_MINUTES=60
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
# Grace period for parallel refreshes before a reused refresh token revokes the session
OAUTH_REFRESH_REUSE_GRACE_SECONDS=10
# Optional comma-separated allowlist of redirect hosts, e.g. claude.ai,localhost,127.0.0.1
OAUTH_REDIRECT_HOSTS=
